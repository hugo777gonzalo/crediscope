# Secrets para las Edge Functions (supabase/functions). Nunca se exponen
# al navegador. Cargar con: supabase secrets set --env-file .env.functions
#
# SUPABASE_URL y SUPABASE_SERVICE_ROLE_KEY NO se configuran acá — Supabase
# las inyecta automáticamente a cada Edge Function (son nombres reservados,
# `secrets set` los rechaza si se intentan fijar a mano).

# Credenciales de Novadata (novascoring) — confirmado en producción:
# login por usuario/contraseña (grant_type=password) contra Keycloak,
# la Edge Function obtiene un access_token (dura 15 min) y lo reusa
# mientras viva. Ver supabase/functions/_shared/novadata-client.ts.
NOVADATA_BASE_URL=https://novadata.novascoring.com
NOVADATA_USERNAME=
NOVADATA_PASSWORD=

# LLM para el scoring aproximado (ver llm-scoring.ts).
ANTHROPIC_API_KEY=
# Solo si la API key es de las "vinculadas a identidad" (pertenece a
# varios workspaces) — Anthropic devuelve un error 400 pidiendo este
# header. Se ve en la URL del dashboard al entrar a un workspace
# específico (console.anthropic.com), formato wrkspc_xxx. Si tu key no
# da ese error, dejar vacío.
ANTHROPIC_WORKSPACE_ID=
